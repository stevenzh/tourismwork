<?xml version="1.0" ?>
<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
            http://www.springframework.org/schema/beans
            http://www.springframework.org/schema/beans/spring-beans.xsd"
  default-autowire="byType">

  <bean id="LineSearchAction" class="com.opentravelsoft.action.manage.product.ListLineAction" scope="prototype">
  </bean>
  <bean id="LineAction" class="com.opentravelsoft.action.manage.product.AddLineAction" scope="prototype">
  </bean>
  <bean id="EditLineAction" class="com.opentravelsoft.action.manage.product.EditLineAction" scope="prototype">
  </bean>
  <bean id="LineDetailAction" class="com.opentravelsoft.action.manage.product.LineDetailAction" scope="prototype">
  </bean>
  <bean id="DuplicateLineAction" class="com.opentravelsoft.action.manage.product.DuplicateLineAction" scope="prototype">
  </bean>

  <!-- RouteSightAction -->
  <bean id="RouteSight" class="com.opentravelsoft.action.manage.product.LineSightAction" scope="prototype">
  </bean>
  <bean id="RouteEditSight" class="com.opentravelsoft.action.manage.product.EditSightAction" scope="prototype">
  </bean>

  <!-- RouteScheduleAction -->
  <bean id="RouteSchedule" class="com.opentravelsoft.action.manage.product.LineScheduleAction" scope="prototype">
  </bean>

  <!-- ShowRouteJourneyAction -->
  <bean id="ShowRouteJourney" class="com.opentravelsoft.action.manage.product.ShowRouteJourneyAction" scope="prototype">
  </bean>

  <!-- RouteNotice -->
  <bean id="RouteRule" class="com.opentravelsoft.action.manage.product.LineRuleAction" scope="prototype">
  </bean>

  <!-- RouteExpence -->
  <bean id="RouteExpense" class="com.opentravelsoft.action.manage.product.LineExpenseAction" scope="prototype">
  </bean>

  <!-- RouteDistrictAction -->
  <bean id="RouteDistrict" class="com.opentravelsoft.action.manage.product.LineDistrictAction" scope="prototype">
  </bean>
  <bean id="EditLineDistrict" class="com.opentravelsoft.action.manage.product.EditDistrictAction" scope="prototype">
  </bean>

  <bean id="RouteVisaAction" class="com.opentravelsoft.action.manage.product.LineVisaAction" scope="prototype">
  </bean>

  <!--RoutePriceAction-->
  <bean id="RoutePrice" class="com.opentravelsoft.action.manage.product.ListPriceAction" scope="prototype">
  </bean>
  <bean id="EditRoutePrice" class="com.opentravelsoft.action.manage.product.EditPriceAction" scope="prototype">
  </bean>

  <!-- Plan -->
  <bean id="RoutePlanAction" class="com.opentravelsoft.action.manage.product.ListPlanAction" scope="prototype">
  </bean>
  <bean id="AddPlan" class="com.opentravelsoft.action.manage.product.AddPlanAction" scope="prototype">
  </bean>

  <!-- Product Item -->
  <bean id="ItemSettingAction" class="com.opentravelsoft.action.manage.product.ItemSettingAction" scope="prototype">
  </bean>
  <bean id="EditItemAction" class="com.opentravelsoft.action.manage.product.EditItemAction" scope="prototype">
  </bean>

  <bean id="ListProductTmpl" class="com.opentravelsoft.action.manage.product.ListProductTmplAction" scope="prototype">
  </bean>
  <bean id="EditProductTmpl" class="com.opentravelsoft.action.manage.product.EditProductTmplAction" scope="prototype">
  </bean>

  <bean id="ListPremiumAction" class="com.opentravelsoft.action.manage.product.ListPremiumAction" scope="prototype">
  </bean>
  <bean id="EditPremiumAction" class="com.opentravelsoft.action.manage.product.EditPremiumAction" scope="prototype">
  </bean>

  <bean id="ListHotelAction" class="com.opentravelsoft.action.manage.vacation.HotelAction" scope="prototype">
  </bean>
</beans>
